rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return hasProfile() && profile().active == true && profile().role == 'admin';
    }
    function canUseStore(storeId) {
      return isAdmin() || (hasProfile()
        && profile().active == true
        && profile().role in ['store_manager', 'viewer']
        && storeId in profile().storeIds);
    }
    function canEditStore(storeId) {
      return isAdmin() || (hasProfile()
        && profile().active == true
        && profile().role == 'store_manager'
        && storeId in profile().storeIds);
    }
    function canCreateAtStore(storeId) {
      return canEditStore(storeId)
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.active == true;
    }
    function validSale(data) {
      return data.keys().hasAll(['date', 'storeId', 'code', 'name', 'qty', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'history'])
        && data.keys().hasOnly(['date', 'storeId', 'code', 'name', 'qty', 'notes', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'history', 'voided', 'voidedBy', 'voidedAt'])
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.storeId is string
        && data.code is string && data.code.size() > 0 && data.code.size() <= 80
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.qty is int && data.qty > 0 && data.qty <= 9007199254740991
        && data.createdBy is string
        && data.updatedBy is string
        && data.history is list
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 500));
    }
    function validHistoryAppend(oldData, newData) {
      let entry = newData.history[newData.history.size() - 1];
      return newData.history.size() == oldData.history.size() + 1
        && newData.history.hasAll(oldData.history)
        && entry.keys().hasOnly(['date', 'storeId', 'code', 'name', 'qty', 'notes', 'changedBy', 'changedAt', 'action'])
        && entry.changedBy == request.auth.uid
        && entry.changedAt is string
        && (!entry.keys().hasAny(['action']) || (isAdmin() && entry.action == 'voided'))
        && ((entry.get('action', '') == 'voided'
            && isAdmin()
            && entry.date == oldData.date
            && entry.storeId == oldData.storeId
            && entry.code == oldData.code
            && entry.name == oldData.name
            && entry.qty == oldData.qty
            && entry.get('notes', '') == oldData.get('notes', ''))
          || (!entry.keys().hasAny(['action'])
            && entry.date == oldData.date
            && entry.storeId == oldData.storeId
            && entry.code == oldData.code
            && entry.name == oldData.name
            && entry.qty == oldData.qty
            && entry.get('notes', '') == oldData.get('notes', '')));
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['email', 'role', 'storeIds', 'active'])
        && request.resource.data.keys().hasOnly(['email', 'role', 'storeIds', 'active', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.role in ['admin', 'store_manager', 'viewer']
        && request.resource.data.storeIds is list
        && request.resource.data.storeIds.size() <= 30
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /stores/{storeId} {
      allow read: if hasProfile() && profile().active == true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['name', 'active', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /salesEntries/{saleId} {
      allow read: if hasProfile() && profile().active == true && canUseStore(resource.data.storeId);
      allow create: if hasProfile()
        && profile().active == true
        && canCreateAtStore(request.resource.data.storeId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.history.size() == 0
        && !request.resource.data.keys().hasAny(['voided', 'voidedBy', 'voidedAt'])
        && validSale(request.resource.data);
      allow update: if hasProfile()
        && profile().active == true
        && canEditStore(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && validHistoryAppend(resource.data, request.resource.data)
        && (isAdmin()
          || (!request.resource.data.keys().hasAny(['voided', 'voidedBy', 'voidedAt'])
            && !resource.data.keys().hasAny(['voided', 'voidedBy', 'voidedAt'])))
        && ((!request.resource.data.keys().hasAny(['voided', 'voidedBy', 'voidedAt'])
            && !resource.data.keys().hasAny(['voided', 'voidedBy', 'voidedAt']))
          || (isAdmin()
            && request.resource.data.get('voided', false) == true
            && resource.data.get('voided', false) == false
            && request.resource.data.voidedBy == request.auth.uid
            && request.resource.data.voidedAt == request.time))
        && validSale(request.resource.data);
      allow delete: if false;
    }

    match /weeklyClosures/{weekId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && !exists(/databases/$(database)/documents/weeklyClosures/$(weekId))
        && request.resource.data.keys().hasAll(['start', 'end', 'total', 'byStore', 'byProduct', 'correctedRecords', 'voidedRecords', 'closedBy', 'closedAt'])
        && request.resource.data.keys().hasOnly(['start', 'end', 'total', 'byStore', 'byProduct', 'correctedRecords', 'voidedRecords', 'closedBy', 'closedAt'])
        && weekId == request.resource.data.start
        && request.resource.data.start is string
        && request.resource.data.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.end is string
        && request.resource.data.end.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.closedBy == request.auth.uid
        && request.resource.data.closedAt == request.time
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.byStore is list
        && request.resource.data.byProduct is list
        && request.resource.data.correctedRecords is int
        && request.resource.data.voidedRecords is int;
      allow update: if false;
      allow delete: if false;
    }

    match /weeklyClosureAmendments/{amendmentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['closureId', 'previousTotal', 'total', 'reason', 'byStore', 'byProduct', 'correctedRecords', 'voidedRecords', 'correctedBy', 'correctedAt'])
        && request.resource.data.keys().hasOnly(['closureId', 'previousTotal', 'total', 'reason', 'byStore', 'byProduct', 'correctedRecords', 'voidedRecords', 'correctedBy', 'correctedAt'])
        && request.resource.data.closureId is string
        && exists(/databases/$(database)/documents/weeklyClosures/$(request.resource.data.closureId))
        && request.resource.data.previousTotal is int
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
        && request.resource.data.byStore is list
        && request.resource.data.byProduct is list
        && request.resource.data.correctedRecords is int
        && request.resource.data.voidedRecords is int
        && request.resource.data.correctedBy == request.auth.uid
        && request.resource.data.correctedAt == request.time;
      allow update, delete: if false;
    }

    match /system/{document=**} {
      allow read, write: if false;
    }
  }
}
